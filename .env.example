# Choose one provider. Leave unused options blank.

# OpenRouter: PaperReader selects only verified zero-priced free models.
OPENROUTER_API_KEY=

# Groq: used directly, or as OpenRouter fallback.
GROQ_API_KEY=

# Any OpenAI-compatible chat endpoint. Takes priority when URL and model are set.
# Example: LLM_BASE_URL=http://localhost:11434/v1 for a local Ollama server.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_VISION_MODEL=
LLM_PROVIDER_NAME=

HOST=127.0.0.1
PORT=3001
