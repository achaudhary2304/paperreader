{
  "name": "paperlens",
  "version": "0.4.10",
  "description": "A local research paper reader and AI companion",
  "author": {
    "name": "Aryan Chaudhary",
    "email": "f20230651@pilani.bits-pilani.ac.in"
  },
  "license": "MIT",
  "repository": "https://github.com/achaudhary2304/paperreader",
  "main": "desktop/main.js",
  "desktopName": "paperlens.desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test server/*.test.js src/*.test.js desktop/*.test.js",
    "start": "node server/index.js",
    "desktop": "node scripts/desktop.mjs",
    "desktop:package": "npm run build && electron-builder --publish never",
    "service:install": "node scripts/install-service.mjs",
    "open": "node scripts/open.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "mathjs": "^15.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^10.2.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "io.github.achaudhary2304.paperlens",
    "productName": "PaperLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*.js",
      "shared/**/*.js",
      "desktop/**/*",
      "package.json",
      "!**/*.test.js",
      "!dist/scaling-inherently-interpretable-language-models.pdf"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "desktop/icon.png",
      "category": "Education",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
